# Copy this file to ".env" and fill in your keys.  (cp .env.example .env)
# All services below are FREE.

# Which LLM to use: groq (default) | gemini | ollama (runs on your Mac, no key)
# If Groq says "rate limit / daily token limit", switch to: LLM_PROVIDER=gemini
LLM_PROVIDER=groq

# Groq - free key from https://console.groq.com/keys
GROQ_API_KEY=""
# gpt-oss-20b hit its daily Groq token limit; each Groq model has its own quota
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini - free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.6-flash

# Hugging Face - free token from https://huggingface.co/settings/tokens
# (used only to download the local embedding model faster)
HUGGINGFACE_API_KEY=""

# Local model with Ollama (https://ollama.com) -> run: ollama pull qwen3.5:2b
OLLAMA_MODEL=qwen3.5:2b

# Optional: LangSmith tracing / observability (Day 20) - free Developer plan at https://smith.langchain.com
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=RAG Document Assistant

# Optional tuning
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
